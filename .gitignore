# Build output (Vite client bundle and manifest)
dist/

# Go binaries produced by make build
bin/

# Generated code — always produced by the generator, never edited by hand
generated/

# Generated client route import map (routegen, E06)
frontend/route-registry.generated.ts

# Go build artifacts
*.exe
*.test
*.out

# Go workspace files
go.work
go.work.sum

# templ-generated Go sources (*_templ.go) are build artifacts of `templ generate`
*_templ.go

# Node / npm
node_modules/
npm-debug.log*

# Environment and editor noise
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
*.swp

# Compiled binaries from local go build verification
/example

# Playwright E2E output (screenshots, traces on failure)
/test-results/
/playwright-report/

# Air build/generation output (meta dev)
.tmp/
