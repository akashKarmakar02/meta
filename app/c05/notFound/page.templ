package notfound

// C05NotFound is the SSR fixture for the loader-error browser test. Its
// registered loader (LoadC05NotFound) always reports a not-found outcome, so in
// the real app this page never renders — the 404 fires before rendering. The
// markup below only matters for the no-loader test app (newApp(nil)), where the
// route renders normally so the route-iterating contract tests still see a
// valid document.
templ C05NotFound() {
	<main data-go-page="c05-not-found">
		<h1>C05 not-found source</h1>
		<p>This page's loader reports not found.</p>
	</main>
}
