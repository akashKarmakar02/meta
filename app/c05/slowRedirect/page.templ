package slowredirect

// C05SlowRedirect is the SSR fixture for the stale-redirect browser test. Its
// registered loader (LoadC05SlowRedirect) sleeps ~400ms before redirecting to
// /about, giving a browser test time to start a second navigation while the
// first is still in flight. The second navigation aborts the first's fetch
// (the server then sees context cancellation), and the stale first result can
// never commit — proving a stale redirect cannot change the current page.
templ C05SlowRedirect() {
	<main data-go-page="c05-slow-redirect">
		<h1>C05 slow redirect source</h1>
		<p>This page's loader redirects to /about after a delay.</p>
	</main>
}
