package guestbook

import (
	"fmt"

	actions "github.com/akashKarmakar02/meta/app/actions"
	"github.com/akashKarmakar02/meta/action"
 "github.com/akashKarmakar02/meta/app/guestbookform"
)

templ Guestbook() {
	<main data-go-page="guestbook">
		<h1>Guestbook</h1>
		@guestbookform.Form(action.FormState{})
		<p data-guestbook-count>{ fmt.Sprintf("%d", len(actions.Guestbook())) }</p>
	</main>
}
