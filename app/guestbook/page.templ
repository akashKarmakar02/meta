package guestbook

import (
	"fmt"

	actions "go-meta/app/actions"
	"go-meta/formcsrf"
)

templ Guestbook() {
	<main data-go-page="guestbook">
		<h1>Guestbook</h1>
		<form method="post" action="/_meta/actions/guestbook.submit" data-go-form="guestbook">
			@formcsrf.HiddenField()
			<label>
				Name
				<input type="text" name="name" required maxlength="80"/>
			</label>
			<label>
				Message
				<textarea name="message" required maxlength="500"></textarea>
			</label>
			<button type="submit">Sign guestbook</button>
		</form>
		<p data-guestbook-count>{ fmt.Sprintf("%d", len(actions.Guestbook())) }</p>
	</main>
}
