package guestbook

import (
	"fmt"

	actions "go-meta/app/actions"
	"go-meta/action"
 "go-meta/app/guestbookform"
)

templ Guestbook() {
	<main data-go-page="guestbook">
		<h1>Guestbook</h1>
		@guestbookform.Form(action.FormState{})
		<p data-guestbook-count>{ fmt.Sprintf("%d", len(actions.Guestbook())) }</p>
	</main>
}
