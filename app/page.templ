package app

// Page renders the site's root route. D02 makes it real content:
// headings and body text render server-side with no JavaScript —
// the D-phase acceptance contract is "text present without JS".
templ Page() {
	<main data-go-page="home">
		<h1>go-meta</h1>
		<p>A Go-first full-stack web framework.</p>
		<p><a href="/meta-example.txt" download>Download a public file</a></p>
		<p><a href="/robots.txt" download>View robots.txt</a></p>
	</main>
}
