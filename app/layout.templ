package app

// Layout is the root document wrapper for SSR pages. D06 generated the
// root->page composition; D01 defines the component contract: full HTML5
// document, metadata in head, and a single content slot in body.
// F07 wraps the page slot in data-go-page-outlet: the server-owned page
// region soft navigation replaces client-side (blueprint 5.2 step 9).
// Everything outside this wrapper — html, head, body — persists across
// soft navigations.
templ Layout(pageContent templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>go-meta</title>
		</head>
		<body>
			<div data-go-page-outlet>
				@pageContent
			</div>
		</body>
	</html>
}
