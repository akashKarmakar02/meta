.PHONY: setup generate build
setup:
	go list -mod=mod github.com/a-h/templ/cmd/templ
	npm install

generate:
	go tool templ generate -ignore-pattern '[/\\]app[/\\].*\[|[/\\]generated[/\\]routepages[/\\]'
	go run -mod=mod github.com/akashKarmakar02/meta/cmd/routegen

build: generate
	npm run build
	mkdir -p bin
	go build -mod=mod -o bin/app ./cmd/app
