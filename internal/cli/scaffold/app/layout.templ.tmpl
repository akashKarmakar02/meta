package app

import "github.com/akashKarmakar02/meta/metadata"

templ Layout(content templ.Component) {
  {{
    metadata.Set(ctx,
    metadata.Page{
      Title: "My Meta app",
      Description: "A web application built with Meta.",
    })
  }}

  <div data-go-layout="app/layout.templ">
    <nav class="flex gap-4 border-b px-8 py-4"><a href="/">Home</a> <a href="/dashboard">Dashboard</a></nav>
    @content
  </div>
}
