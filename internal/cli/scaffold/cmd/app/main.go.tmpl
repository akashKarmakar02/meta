package main

import (
	"log"
	"net"
	"os"
	"time"

	"github.com/gofiber/fiber/v3"
	generated "{{MODULE}}/generated"
	apphooks "{{MODULE}}/app"
	"github.com/akashKarmakar02/meta/cache"
	"github.com/akashKarmakar02/meta/env"
	"github.com/akashKarmakar02/meta/pagecache"
	"github.com/akashKarmakar02/meta/server"
)

func main() {
	isDev := os.Getenv("GO_META_DEV") == "1"
	if !isDev {
		if err := env.LoadProduction("."); err != nil { log.Fatal(err) }
	}
	cfg := server.Config{
		PublicDir: "public",
		GlobalStylesheet: true,
		Middleware: []fiber.Handler{apphooks.Handle}, Policies: apphooks.Policies(),
		Routes: generated.RegisterRoutes(), APIRoutes: generated.RegisterAPIRoutes(), SSRPage: generated.SSRPage,
		BarePage: generated.BarePage, VisualLayout: generated.VisualLayout, HealthCheck: true,
	}
	if origin := os.Getenv("GO_META_VITE_ORIGIN"); origin != "" {
		cfg.DevOrigin = origin
	} else {
		cfg.ClientDir = "dist/client"
	}

	// Page caching is enabled by default in production (disk-backed, no TTL expiry —
	// entries live until you invalidate them after mutations). It is NEVER active
	// in development: every request renders fresh so templ changes appear
	// immediately. To disable production caching set GO_META_PAGE_CACHE_DISABLED=1.
	if !isDev && os.Getenv("GO_META_PAGE_CACHE_DISABLED") == "" {
		store, err := cache.NewDiskStore(cache.DiskConfig{
			Dir:           envOr("GO_META_PAGE_CACHE_DIR", ".pagecache"),
			MaxEntryBytes: 2 << 20,
			SweepInterval: 10 * time.Minute,
		})
		if err != nil { log.Fatal(err) }
		cfg.PageCache = pagecache.NewPageCache(store, cache.Never)
	}
	if isDev {
		// Development must never serve cached HTML: every request re-renders so
		// templ edits show up immediately and stale pages are never served.
		log.Println("development mode: page caching disabled")
	}

	app, err := server.New(cfg)
	if err != nil { log.Fatal(err) }
	if socket := os.Getenv("GO_META_DEV_SOCKET"); socket != "" {
		if info, err := os.Lstat(socket); err == nil {
			if info.Mode() & os.ModeSocket == 0 { log.Fatal("development socket path is not a socket") }
			if err := os.Remove(socket); err != nil { log.Fatal(err) }
		} else if !os.IsNotExist(err) { log.Fatal(err) }
		listener, err := net.Listen("unix", socket)
		if err != nil { log.Fatal(err) }
		log.Fatal(app.Listener(listener))
	}
	port := os.Getenv("PORT")
	if port == "" { port = "3000" }
	log.Fatal(app.Listen(":" + port))
}

func envOr(key, fallback string) string {
	if v := os.Getenv(key); v != "" { return v }
	return fallback
}
